rules_version = '2';

// Regras do Firebase Storage — onde as fotos da anamnese passaram a morar.
//
// Antes, cada foto era uma string base64 dentro do próprio documento do Firestore: três imagens
// já estouravam o teto de 1 MB por documento, e toda leitura de uma ficha (ou da coleção inteira,
// no início da sessão) baixava as fotos junto. Aqui a imagem vira um arquivo com URL própria.
//
// Leitura é aberta em todos os caminhos pelo mesmo motivo das fichas no Firestore: a paciente
// abre a própria ficha por um link, sem login. O segredo é a URL — o Firebase gera um token
// aleatório por arquivo, e sem ele o caminho não abre.
//
// Para publicar:  firebase deploy --only storage
service firebase.storage {
  match /b/{bucket}/o {

    function ehImagem() {
      return request.resource.contentType.matches('image/.*');
    }

    function cabeNoLimite() {
      return request.resource.size < 5 * 1024 * 1024;
    }

    // Fotos de referência (mapa anatômico, por gênero) e imagem orientativa das fichas-modelo.
    // Só a equipe logada envia; qualquer paciente com o link da ficha precisa conseguir ver.
    match /anamnese/fichas-modelo/{templateId}/{arquivo} {
      allow read: if true;
      allow write: if request.auth != null && ehImagem() && cabeNoLimite();
    }

    // Fotos enviadas pela própria paciente no formulário online. Ela não tem login — é o mesmo
    // motivo pelo qual `anamnesis_records` aceita escrita sem autenticação no Firestore.
    match /anamnese/fotos-pacientes/{arquivo} {
      allow read: if true;
      allow write: if ehImagem() && cabeNoLimite();
    }

    // Versões com as anotações do profissional (doses, vetores, unidades). Só a equipe grava.
    match /anamnese/fotos-anotadas/{arquivo} {
      allow read: if true;
      allow write: if request.auth != null && ehImagem() && cabeNoLimite();
    }

    // Identidade da clínica: logo, banner de capa e fotos da equipe.
    //
    // Estas eram as últimas imagens que ainda ficavam em base64 dentro do Firestore. O perfil da
    // clínica é gravado em dois documentos e o espelho público é reescrito inteiro, então cada
    // imagem embutida era cobrada de novo a cada gravação. Leitura aberta porque a página da
    // paciente (ficha e orçamento, ambas sem login) mostra o logo e a foto da profissional.
    match /clinica/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && ehImagem() && cabeNoLimite();
    }

    // Manequins do mapa corporal da depilação a laser (corpo frente e corpo costas). Leitura
    // aberta porque a paciente vê o manequim ao escolher as áreas na ficha, sem login.
    match /clinica/laser-manequim/{arquivo} {
      allow read: if true;
      allow write: if request.auth != null && ehImagem() && cabeNoLimite();
    }

    // Fotos dos procedimentos do catálogo oficial.
    // Qualquer paciente ou visitante com o catálogo aberto pode visualizar; apenas a equipe logada grava/atualiza.
    match /procedimentos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && ehImagem() && cabeNoLimite();
    }

    // Fichas de avaliação: mapa anatômico das fichas-modelo, foto de cada sessão e as versões
    // anotadas. Só a equipe envia — a paciente nunca preenche nem enxerga avaliação.
    //
    // Precisa existir: sem regra, o envio falha, e `subirImagem` trata falha devolvendo a própria
    // data URL. O resultado silencioso seria a foto voltar a ser base64 dentro do documento do
    // Firestore — exatamente o que este arquivo existe para acabar.
    //
    // Leitura aberta como em todos os caminhos acima, pelo mesmo motivo: o segredo é o token
    // aleatório que o Firebase põe na URL de cada arquivo. Quem mantém a avaliação fora da vista
    // da paciente é `firestore.rules`, que fecha `evaluation_records` — sem o documento, não há
    // como chegar a nenhuma destas URLs.
    match /avaliacoes/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && ehImagem() && cabeNoLimite();
    }

    // Qualquer outro caminho fica fechado.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
