rules_version = '2';

// Regras do Firebase Storage — onde as fotos da anamnese passaram a morar.
//
// Antes, cada foto era uma string base64 dentro do próprio documento do Firestore: três imagens
// já estouravam o teto de 1 MB por documento, e toda leitura de uma ficha (ou da coleção inteira,
// no início da sessão) baixava as fotos junto. Aqui a imagem vira um arquivo com URL própria.
//
// COMO AS FOTOS APARECEM PARA QUEM NÃO TEM LOGIN
// A paciente vê imagens (o manequim, o logo, a foto da profissional, o comprovante do orçamento)
// pela URL de download que ficou gravada no documento. Essa URL leva um token aleatório e abre
// sozinha — estas regras não valem para ela. As regras valem para o acesso pelo SDK: listar uma
// pasta, ler um arquivo pelo caminho, enviar, apagar.
//
// POR ISSO, NINGUÉM LISTA PASTA NENHUMA
// O app nunca lista pastas. `read` (que inclui `list`) estava aberto em todos os caminhos, e
// qualquer pessoa conseguia listar `acompanhamentos/` e baixar as fotos clínicas de antes e depois
// de todas as pacientes. Agora cada caminho libera só `get` (ler um arquivo cujo caminho se
// conhece — os nomes são randomUUID) e nada libera `list`.
//
// FOTOS CLÍNICAS SÓ PARA QUEM TEM LOGIN
// Avaliação, acompanhamento, fotos anotadas e comprovantes: `get` só com login. Quem tem login e
// não é da equipe não consegue chegar a esses caminhos — os nomes são aleatórios e as pastas não
// listam. (A conferência de "é da equipe" mora em firestore.rules; daqui não dá para consultar o
// banco nomeado do painel.)
//
// Para publicar:  npm run publicar-regras   (ver docs/publicar-regras.md)
service firebase.storage {
  match /b/{bucket}/o {

    function ehImagem() {
      return request.resource.contentType.matches('image/.*');
    }

    function cabeNoLimite() {
      return request.resource.size < 5 * 1024 * 1024;
    }

    function logado() {
      return request.auth != null;
    }

    // Fotos de referência (mapa anatômico, por gênero) e imagem orientativa das fichas-modelo.
    // Só a equipe envia; a página da paciente mostra pela URL gravada na ficha-modelo.
    match /anamnese/fichas-modelo/{templateId}/{arquivo} {
      allow get: if true;
      allow create, update: if logado() && ehImagem() && cabeNoLimite();
      allow delete: if logado();
    }

    // Fotos enviadas pela própria paciente no formulário online. Ela não tem login, então o
    // envio de um arquivo NOVO é aberto (só imagem, até 5 MB) e o `get` também — o navegador
    // dela pede a URL de download do arquivo que acabou de enviar. Trocar ou apagar uma foto
    // existente é só da equipe.
    //
    // `resource == null` é o que faz valer o "NOVO": no Storage, enviar por cima de um arquivo
    // que já existe conta como `create`, não `update`. Sem isso, quem soubesse o caminho de uma
    // foto trocaria a imagem da paciente sem login.
    match /anamnese/fotos-pacientes/{arquivo} {
      allow get: if true;
      allow create: if (resource == null || logado()) && ehImagem() && cabeNoLimite();
      allow update: if logado() && ehImagem() && cabeNoLimite();
      allow delete: if logado();
    }

    // Versões com as anotações do profissional (doses, vetores, unidades). Só a equipe.
    match /anamnese/fotos-anotadas/{arquivo} {
      allow get: if logado();
      allow create, update: if logado() && ehImagem() && cabeNoLimite();
      allow delete: if logado();
    }

    // Identidade da clínica: logo, banner de capa e fotos da equipe; e os manequins do mapa
    // corporal da depilação a laser (`clinica/laser-manequim/`). Não há dado de paciente aqui.
    match /clinica/{allPaths=**} {
      allow get: if true;
      allow create, update: if logado() && ehImagem() && cabeNoLimite();
      allow delete: if logado();
    }

    // Fotos dos procedimentos do catálogo oficial.
    match /procedimentos/{allPaths=**} {
      allow get: if true;
      allow create, update: if logado() && ehImagem() && cabeNoLimite();
      allow delete: if logado();
    }

    // Fichas de avaliação: mapa anatômico das fichas-modelo, a foto da avaliação e as versões
    // anotadas. Só a equipe — a paciente nunca preenche nem enxerga avaliação.
    //
    // Precisa existir: sem regra, o envio falha, e `subirImagem` trata falha devolvendo a própria
    // data URL. O resultado silencioso seria a foto voltar a ser base64 dentro do documento do
    // Firestore — exatamente o que este arquivo existe para acabar.
    match /avaliacoes/{allPaths=**} {
      allow get: if logado();
      allow create, update: if logado() && ehImagem() && cabeNoLimite();
      allow delete: if logado();
    }

    // Acompanhamento: mapa anatômico das fichas-modelo, foto de cada atendimento, as versões
    // anotadas e as fotos do antes e depois (`acompanhamentos/antes-depois/{pacienteId}/`).
    // Mesma regra e mesmo motivo da avaliação logo acima.
    match /acompanhamentos/{allPaths=**} {
      allow get: if logado();
      allow create, update: if logado() && ehImagem() && cabeNoLimite();
      allow delete: if logado();
    }

    // Comprovantes de pagamento dos orçamentos — foto ou PDF, anexados pela equipe ao marcar o
    // orçamento como pago. A cliente vê o comprovante pela URL gravada no orçamento.
    //
    // 10 MB e não 5: aqui entra PDF, que não dá para reduzir no navegador como se faz com a foto.
    // `delete` separado de `create`/`update` porque na exclusão não existe `request.resource`, e
    // a checagem de tipo recusaria o pedido.
    match /orcamentos/{quoteId}/comprovantes/{arquivo} {
      allow get: if logado();
      allow create, update: if logado()
        && (ehImagem() || request.resource.contentType == 'application/pdf')
        && request.resource.size < 10 * 1024 * 1024;
      allow delete: if logado();
    }

    // Comprovantes anexados às notas de recibo — foto ou PDF, mesmos limites do caminho acima.
    match /recibos/{receiptId}/comprovantes/{arquivo} {
      allow get: if logado();
      allow create, update: if logado()
        && (ehImagem() || request.resource.contentType == 'application/pdf')
        && request.resource.size < 10 * 1024 * 1024;
      allow delete: if logado();
    }

    // A foto ou o PDF de um pedido de compra do Estoque — mesmos limites dos comprovantes.
    match /pedidos/{pedidoId}/{arquivo} {
      allow get: if logado();
      allow create, update: if logado()
        && (ehImagem() || request.resource.contentType == 'application/pdf')
        && request.resource.size < 10 * 1024 * 1024;
      allow delete: if logado();
    }

    // Qualquer outro caminho fica fechado.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
