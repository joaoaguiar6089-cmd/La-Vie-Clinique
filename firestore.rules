rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Quem é da equipe: um login que está em `equipeUids`, a lista dos uids das profissionais
    // gravada no perfil da clínica (ver src/utils/equipe.ts).
    //
    // "Estar logado" não basta: o cadastro de contas do Firebase é aberto — o botão "Criar login"
    // do painel depende dele —, então qualquer pessoa pode criar uma conta. Antes, toda regra
    // abaixo dizia só `request.auth != null`, e uma conta criada por fora lia recibos com CPF,
    // atendimentos, financeiro e o resto.
    function ehDaEquipe() {
      return request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/clinic_settings/main_profile)
             .data.get('equipeUids', []);
    }

    // Procedures collection: só a equipe gerencia o catálogo.
    match /procedures/{procedureId} {
      allow read, write: if ehDaEquipe();
    }

    // Espelho público do perfil da clínica: só nome, contato, endereço e a equipe sem os dados
    // de login. É o que a página da ficha de anamnese (aberta pela paciente, sem conta) lê para
    // se identificar. Precisa vir ANTES da regra geral de clinic_settings — as regras do Firestore
    // são unidas por OU, então esta apenas abre a leitura deste documento específico.
    match /clinic_settings/public_profile {
      allow read: if true;
      allow write: if ehDaEquipe();
    }

    // Mapa corporal da depilação a laser: as duas imagens dos manequins e os polígonos de cada
    // área, sem preço nenhum. A paciente escolhe as áreas pretendidas pela ficha de anamnese, que
    // ela abre por link e sem conta — e a coleção `procedures`, onde as áreas realmente moram,
    // exige login para leitura. Mesma solução (e mesma posição, antes da regra geral) do
    // public_profile logo acima.
    match /clinic_settings/laser_body_map {
      allow read: if true;
      allow write: if ehDaEquipe();
    }

    // Clinic settings document: identidade da clínica, profissionais cadastradas, contato.
    // Contém os vínculos de login (email/uid/isAdmin) das profissionais — não pode ser público.
    //
    // A exceção do `create` é só para a primeira instalação, quando o perfil ainda não existe e
    // portanto não há equipe: quem cria o perfil precisa estar na lista que está criando. Num
    // projeto em uso o perfil já existe, e `create` nunca se aplica a um documento existente.
    match /clinic_settings/{docId} {
      allow read, write: if ehDaEquipe();
      allow create: if docId == 'main_profile'
        && request.auth != null
        && request.auth.uid in request.resource.data.get('equipeUids', []);
    }

    // Anamnesis Module: perguntas gerais herdadas por todas as fichas. Precisa ser lida sem
    // login pelo formulário público (link exclusivo do paciente); só a equipe edita. Não tem
    // dado de paciente nenhum.
    match /anamnesis_general_questions/{questionId} {
      allow read: if true;
      allow write: if ehDaEquipe();
    }

    // Anamnesis Module: modelos de ficha por procedimento. Mesma lógica acima.
    match /anamnesis_templates/{templateId} {
      allow read: if true;
      allow write: if ehDaEquipe();
    }

    // Cadastro de pacientes e fichas de anamnese preenchidas: só a equipe.
    //
    // Ficaram abertas a qualquer pessoa (`if true`) enquanto a página da paciente lia e gravava
    // direto no banco — e com elas, qualquer um podia listar todos os cadastros (nome, CPF,
    // telefone, nascimento), ler todas as fichas, alterar ou apagar. Agora a página da paciente
    // fala com o servidor (`/api/ficha-publica`, ver server/fichaPublica.ts), que confere o link,
    // confere CPF e nascimento antes de abrir uma ficha fechada e grava só o que a paciente
    // preenche. O servidor usa uma conta de serviço e não passa por estas regras.
    match /patients/{patientId} {
      allow read, write: if ehDaEquipe();
    }

    match /anamnesis_records/{recordId} {
      allow read, write: if ehDaEquipe();
    }

    // Orçamentos: a paciente abre o dela pelo link (?orcamento=<id>) sem login, então o `get` é
    // público — o segredo é o ID, gerado com crypto.randomUUID() e portanto não adivinhável.
    // `list` é só da equipe: com ele aberto, qualquer pessoa baixava todos os orçamentos de todas
    // as pacientes de uma vez, sem precisar de id nenhum. Escrita é só da equipe: a página
    // pública não grava nada, nem o aceite.
    match /quotes/{quoteId} {
      allow get: if true;
      allow list, write: if ehDaEquipe();
    }

    // Contadores da numeração sequencial dos orçamentos (counters/quotes_<ano>) e das notas de
    // recibo (counters/receipts_<ano>). Nunca são lidos pela página pública — só pela transação
    // que emite um documento novo.
    match /counters/{counterId} {
      allow read, write: if ehDaEquipe();
    }

    // Notas de recibo de pagamento. Fechadas nos dois sentidos, ao contrário de `quotes`: o recibo
    // leva o CPF da cliente, e ela o recebe em PDF, não por um link — então ninguém sem login
    // precisa ler esta coleção.
    match /receipts/{receiptId} {
      allow read, write: if ehDaEquipe();
    }

    // Atendimentos (o diário da clínica: visitas realizadas e agendamentos) e os planos de
    // sessão que os agrupam. Aqui a regra é mais fechada que a de `patients` e
    // `anamnesis_records` logo acima, e de propósito: aqueles ficam abertos porque a paciente
    // preenche a própria ficha por link e sem conta — atendimento nenhuma paciente enxerga.
    match /attendances/{attendanceId} {
      allow read, write: if ehDaEquipe();
    }

    match /session_plans/{planId} {
      allow read, write: if ehDaEquipe();
    }

    // Link do agendamento: a cópia enxuta de um agendamento que a clínica manda à paciente
    // (?agendamento=<token>) para ela confirmar, avisar que não vai ou pedir outro horário. É a
    // única coleção da agenda que alguém sem login toca, então cada permissão é a menor possível:
    //
    //  - `get` é público e vale só por id. O segredo é o token, um crypto.randomUUID() — a mesma
    //    proteção dos orçamentos. `list` fica com a equipe: sem isso qualquer pessoa enumeraria
    //    todos os tokens e leria os agendamentos de todas as pacientes.
    //  - Quem não tem login só pode ATUALIZAR, só enquanto o agendamento está ativo, e só os três
    //    campos da resposta. Horário, nome, foto e clínica são da equipe.
    //  - A resposta é validada por `respostaValida`: tipo dentro da lista, data e hora no formato
    //    certo, recado curto. Assim o campo não vira um depósito de texto de terceiros.
    //
    // Nada aqui contém observação interna, preço, id ou contato da paciente (ver
    // `montarSnapshotDoLink`). Publicar com: firebase deploy --only firestore:rules
    match /appointment_links/{token} {
      function respostaValida(r) {
        return r is map
          && r.keys().hasOnly(['tipo', 'novaData', 'novaHora', 'mensagem'])
          && r.tipo in ['confirmar', 'nao_vai', 'remarcar']
          && (!('mensagem' in r) || (r.mensagem is string && r.mensagem.size() <= 300))
          && (r.tipo != 'remarcar' || (
                'novaData' in r && r.novaData is string
                && r.novaData.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                && 'novaHora' in r && r.novaHora is string
                && r.novaHora.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')))
          && (r.tipo == 'remarcar' || (!('novaData' in r) && !('novaHora' in r)));
      }

      allow get: if true;
      allow list, create, delete: if ehDaEquipe();
      allow update: if ehDaEquipe()
        || (
          resource.data.situacao == 'ativo'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['resposta', 'respostaPendente', 'respondidoEm'])
          && request.resource.data.respostaPendente == true
          && request.resource.data.respondidoEm is string
          && request.resource.data.respondidoEm.size() <= 40
          && respostaValida(request.resource.data.resposta)
        );
    }

    // Fichas de avaliação: o que a profissional avalia ANTES do procedimento — fototipo,
    // estratégia proposta, o mapa anatômico rabiscado e a foto do estado inicial.
    //
    // Fechadas nos três casos, ao contrário de `anamnesis_templates` e
    // `anamnesis_general_questions`, que são de leitura pública. A diferença não é descuido: a
    // anamnese precisa abrir sem login porque é a paciente quem a preenche, pelo link. Avaliação
    // ela nunca vê — nem o modelo, que denunciaria o que a clínica observa sem dizer, nem o
    // preenchido, que é documento interno da equipe.
    match /evaluation_templates/{templateId} {
      allow read, write: if ehDaEquipe();
    }

    match /evaluation_general_questions/{questionId} {
      allow read, write: if ehDaEquipe();
    }

    // As avaliações emitidas pela seção têm id próprio; as antigas, de quando havia uma por
    // atendimento, têm o ID dele — previsível, mais uma razão para não abrir a leitura.
    match /evaluation_records/{recordId} {
      allow read, write: if ehDaEquipe();
    }

    // Acompanhamento: o registro DEPOIS de cada atendimento — foto, respostas, o debriefing da
    // sessão. Mesmas regras e mesma razão da avaliação: documento interno da equipe, que a
    // paciente nunca vê. O registro tem o ID do atendimento.
    match /followup_templates/{templateId} {
      allow read, write: if ehDaEquipe();
    }

    match /followup_general_questions/{questionId} {
      allow read, write: if ehDaEquipe();
    }

    match /followup_records/{attendanceId} {
      allow read, write: if ehDaEquipe();
    }

    // Estoque: produtos com valor comprado e valor repassado, o consumo padrão de cada
    // procedimento e os materiais usados em cada atendimento. Custo e margem são da equipe —
    // nada disto pode ser lido por quem não tem login, e nada disto vai para `quotes`, que é
    // público pelo link da cliente.
    match /stock_products/{productId} {
      allow read, write: if ehDaEquipe();
    }

    match /procedure_consumption/{procedureId} {
      allow read, write: if ehDaEquipe();
    }

    match /attendance_materials/{attendanceId} {
      allow read, write: if ehDaEquipe();
    }

    // Custo estimado de material de cada orçamento, com o ID dele. Mora aqui, e não dentro do
    // orçamento, por causa da regra de `quotes` lá em cima: aquela coleção é legível sem login,
    // pelo link da cliente — custo e margem gravados nela estariam à vista dela no navegador.
    // Esta aqui é só da equipe.
    match /quote_costs/{quoteId} {
      allow read, write: if ehDaEquipe();
    }

    // Estoque com lotes: os lotes de cada compra (com o saldo), o mínimo de cada tipo de produto e
    // os pedidos de compra. Só da equipe, como o resto do estoque.
    match /stock_lots/{loteId} {
      allow read, write: if ehDaEquipe();
    }

    match /stock_types/{tipoId} {
      allow read, write: if ehDaEquipe();
    }

    match /purchase_orders/{pedidoId} {
      allow read, write: if ehDaEquipe();
    }

    // Simulações de custo, do Financeiro: custo de material, só da equipe. Aqui, no projeto da
    // La Vie, quem é administradora mora no perfil da clínica e não no login — o "cada uma vê só
    // as suas" é da tela. Na Zulia as regras conferem (ver zulia/firestore.rules).
    match /cost_simulations/{simulacaoId} {
      allow read, write: if ehDaEquipe();
    }

    // Qualquer coleção não prevista acima fica fechada por padrão (nega tudo), em vez do
    // catch-all aberto anterior — reduz a superfície de dados expostos sem querer.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
