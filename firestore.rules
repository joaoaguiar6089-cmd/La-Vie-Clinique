rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Procedures collection: só a equipe logada (profissionais/admin) gerencia o catálogo.
    match /procedures/{procedureId} {
      allow read, write: if request.auth != null;
    }

    // Espelho público do perfil da clínica: só nome, contato, endereço e a equipe sem os dados
    // de login. É o que a página da ficha de anamnese (aberta pela paciente, sem conta) lê para
    // se identificar. Precisa vir ANTES da regra geral de clinic_settings — as regras do Firestore
    // são unidas por OU, então esta apenas abre a leitura deste documento específico.
    match /clinic_settings/public_profile {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Mapa corporal da depilação a laser: as duas imagens dos manequins e os polígonos de cada
    // área, sem preço nenhum. A paciente escolhe as áreas pretendidas pela ficha de anamnese, que
    // ela abre por link e sem conta — e a coleção `procedures`, onde as áreas realmente moram,
    // exige login para leitura. Mesma solução (e mesma posição, antes da regra geral) do
    // public_profile logo acima.
    match /clinic_settings/laser_body_map {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Clinic settings document: identidade da clínica, profissionais cadastradas, contato.
    // Contém os vínculos de login (email/uid/isAdmin) das profissionais — não pode ser público.
    match /clinic_settings/{docId} {
      allow read, write: if request.auth != null;
    }

    // Anamnesis Module: perguntas gerais herdadas por todas as fichas. Precisa ser lida sem
    // login pelo formulário público (link exclusivo do paciente); só a equipe edita.
    match /anamnesis_general_questions/{questionId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Anamnesis Module: modelos de ficha por procedimento. Mesma lógica acima.
    match /anamnesis_templates/{templateId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Cadastro de pacientes: pacientes nunca têm login — o acesso deles é sempre pelo link
    // exclusivo da ficha (protegido por confirmação de CPF + data de nascimento na aplicação,
    // não nestas regras). Mantido aberto para preservar o preenchimento online sem conta.
    match /patients/{patientId} {
      allow read, write: if true;
    }

    // Fichas de anamnese preenchidas: mesma razão do patients acima — o paciente preenche e
    // revisita a própria ficha sem login, usando o ID exclusivo do link como segredo de acesso.
    match /anamnesis_records/{recordId} {
      allow read, write: if true;
    }

    // Orçamentos: a paciente abre o dela pelo link (?orcamento=<id>) sem login, então a
    // leitura é pública — o segredo é o ID, gerado com crypto.randomUUID() e portanto não
    // adivinhável. Escrita é só da equipe: a página pública não grava nada, nem o aceite.
    match /quotes/{quoteId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Contadores da numeração sequencial dos orçamentos (counters/quotes_<ano>). Nunca são
    // lidos pela página pública — só pela transação que emite um orçamento novo.
    match /counters/{counterId} {
      allow read, write: if request.auth != null;
    }

    // Atendimentos (o diário da clínica: visitas realizadas e agendamentos) e os planos de
    // sessão que os agrupam. Aqui a regra é mais fechada que a de `patients` e
    // `anamnesis_records` logo acima, e de propósito: aqueles ficam abertos porque a paciente
    // preenche a própria ficha por link e sem conta — atendimento nenhuma paciente enxerga.
    match /attendances/{attendanceId} {
      allow read, write: if request.auth != null;
    }

    match /session_plans/{planId} {
      allow read, write: if request.auth != null;
    }

    // Fichas de avaliação: o que a profissional responde DEPOIS do atendimento — fototipo,
    // estratégia proposta, evolução, o mapa anatômico rabiscado e a foto da sessão.
    //
    // Fechadas nos três casos, ao contrário de `anamnesis_templates` e
    // `anamnesis_general_questions`, que são de leitura pública. A diferença não é descuido: a
    // anamnese precisa abrir sem login porque é a paciente quem a preenche, pelo link. Avaliação
    // ela nunca vê — nem o modelo, que denunciaria o que a clínica observa sem dizer, nem o
    // preenchido, que é documento interno da equipe.
    match /evaluation_templates/{templateId} {
      allow read, write: if request.auth != null;
    }

    match /evaluation_general_questions/{questionId} {
      allow read, write: if request.auth != null;
    }

    // Um documento por atendimento, com o ID do atendimento. O ID ser previsível (e não um
    // randomUUID como o do orçamento) é mais uma razão para não abrir a leitura.
    match /evaluation_records/{attendanceId} {
      allow read, write: if request.auth != null;
    }

    // Qualquer coleção não prevista acima fica fechada por padrão (nega tudo), em vez do
    // catch-all aberto anterior — reduz a superfície de dados expostos sem querer.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
