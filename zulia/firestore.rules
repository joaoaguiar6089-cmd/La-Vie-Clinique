rules_version = '2';

// Regras do Firestore da Zulia (projeto `zulia-plataforma`), com cada clínica em
// `clinicas/{c}/...`. São as regras da La Vie (`/firestore.rules`) coleção por coleção, trocando
// "é da equipe" por "é desta clínica". As da raiz continuam sendo as do projeto da La Vie até a
// migração, e NUNCA são publicadas aqui (ver docs/zulia-plataforma.md).
//
// QUEM É DE QUAL CLÍNICA
// O login carrega, em custom claims gravadas pelo servidor (Admin SDK), a clínica (`clinicaId`) e o
// papel (`admin` ou `profissional`). O dono da plataforma tem `donoDaPlataforma: true`. As regras
// conferem só a claim — nenhum `get()` de perfil: a claim é a autoridade, e não custa leitura.
// Um login sem claim de clínica (alguém que criou conta por fora) não alcança nada além do que é
// público por link.
//
// O QUE O DONO VÊ
// Nada pelo navegador. O painel do dono passa pelo servidor (`server/dono.ts`), que exige o login
// do dono COM o segundo fator e entrega só o que é da conta da clínica (plano, uso em números,
// logins, último acesso). As coleções de dentro da clínica, nunca: a clínica é a controladora dos
// dados das pacientes e a plataforma, a operadora.
//
// Publicar com:  npm run publicar-regras -- --projeto zulia   (ver docs/publicar-regras.md)
// Testar com:    scripts/verificar-regras-zulia.ts
service cloud.firestore {
  match /databases/{database}/documents {

    // `get` em vez de `.clinicaId`: num login sem a claim, o acesso direto vira erro, e o erro
    // dentro de um `||` é uma armadilha. Com `get`, a resposta é simplesmente "não".
    function daClinica(c) {
      return request.auth != null && request.auth.token.get('clinicaId', null) == c;
    }

    // A admin da clínica (a dona). Hoje as gravações de admin (equipe, plano) passam pelo servidor;
    // esta função existe para as regras de plano e limites da etapa 3.
    function adminDa(c) {
      return daClinica(c) && request.auth.token.get('papel', null) == 'admin';
    }

    function dono() {
      return request.auth != null && request.auth.token.get('donoDaPlataforma', false) == true;
    }

    // ==========================================
    // PLANOS E LIMITES (ver src/utils/planos.ts — os números são os de LIMITES_DO_GRATUITO)
    // ==========================================
    //
    // `clinicas/{c}.uso.clientes` e `.uso.procedimentos` contam os cadastros que existem (cliente
    // arquivada conta; só excluir de vez libera). Cada contador sobe ou desce em 1 na MESMA gravação
    // em que o cadastro nasce ou some, e `uso.ultimoCliente`/`uso.ultimoProcedimento` dizem qual —
    // é assim que a regra confere que o contador não foi mexido à toa. No plano gratuito, criar sem
    // o contador, ou passar do limite, é recusado. No completo, o contador é mantido pelo painel,
    // mas não é exigido (um caminho esquecido não trava quem paga; o servidor recalcula o uso
    // quando o plano muda, com `scripts/recontar-uso.ts`).

    function caminhoDaClinica(c) {
      return /databases/$(database)/documents/clinicas/$(c);
    }

    function cadastro(c, colecao, id) {
      return /databases/$(database)/documents/clinicas/$(c)/$(colecao)/$(id);
    }

    // Plano desconhecido vale como gratuito: na dúvida, o mais restrito.
    function planoGratuito(c) {
      return get(caminhoDaClinica(c)).data.get('plano', 'gratuito') != 'completo';
    }

    // No documento da clínica: o contador mudou em 1, junto com o cadastro `ultimo` nascendo (+1)
    // ou sumindo (-1) nesta mesma gravação.
    function contadorAcompanha(c, contador, ultimo, colecao) {
      let antes = resource.data.get('uso', {}).get(contador, 0);
      let depois = request.resource.data.get('uso', {}).get(contador, 0);
      let id = request.resource.data.get('uso', {}).get(ultimo, '');
      return id is string && id.size() > 0
        && ((depois == antes + 1 && !exists(cadastro(c, colecao, id)) && existsAfter(cadastro(c, colecao, id)))
          || (depois == antes - 1 && exists(cadastro(c, colecao, id)) && !existsAfter(cadastro(c, colecao, id))));
    }

    // A única gravação da equipe no documento da clínica: um dos contadores de uso.
    function soContadorDeUso(c) {
      let usoAntes = resource.data.get('uso', {});
      let usoDepois = request.resource.data.get('uso', {});
      let noUso = usoDepois.diff(usoAntes).affectedKeys();
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uso'])
        && ((noUso.hasOnly(['clientes', 'ultimoCliente']) && contadorAcompanha(c, 'clientes', 'ultimoCliente', 'patients'))
          || (noUso.hasOnly(['procedimentos', 'ultimoProcedimento']) && contadorAcompanha(c, 'procedimentos', 'ultimoProcedimento', 'procedures')));
    }

    // Na criação de um cadastro (plano gratuito): o contador sobe em 1 nesta gravação, apontando
    // para este cadastro, e não passa do limite.
    function criacaoContada(c, contador, ultimo, id, limite) {
      let antes = get(caminhoDaClinica(c)).data.get('uso', {}).get(contador, 0);
      let depois = getAfter(caminhoDaClinica(c)).data.get('uso', {});
      return depois.get(contador, 0) == antes + 1 && depois.get(ultimo, '') == id && depois.get(contador, 0) <= limite;
    }

    match /clinicas/{c} {
      // Os membros leem o próprio documento (plano, recursos, uso); o dono, só pelo servidor. Pelo
      // navegador, a equipe só mexe nos contadores de uso, e só junto com o cadastro que nasce ou
      // some (ver "PLANOS E LIMITES"). Criar clínica, mudar plano e recursos são do servidor.
      allow read: if daClinica(c);
      allow update: if daClinica(c) && soContadorDeUso(c);
      allow create, delete: if false;

      // Catálogo de procedimentos: só a equipe. No plano gratuito, até 2 (criação contada).
      match /procedures/{procedureId} {
        allow read, update, delete: if daClinica(c);
        allow create: if daClinica(c)
          && (!planoGratuito(c) || criacaoContada(c, 'procedimentos', 'ultimoProcedimento', procedureId, 2));
      }

      // Espelho público do perfil (nome, contato, endereço, a equipe sem dados de login): é o que a
      // página da paciente, sem conta, lê para se identificar.
      match /clinic_settings/public_profile {
        allow read: if true;
        allow write: if daClinica(c);
      }

      // Mapa corporal da depilação a laser, sem preço: a paciente escolhe as áreas pela ficha.
      match /clinic_settings/laser_body_map {
        allow read: if true;
        allow write: if daClinica(c);
      }

      // Perfil completo (com os vínculos de login), migrações, Google Agenda e o resto.
      match /clinic_settings/{docId} {
        allow read, write: if daClinica(c);
      }

      // Perguntas gerais e fichas-modelo da anamnese: o formulário público (link da paciente)
      // precisa ler; só a equipe edita. Não têm dado de paciente.
      match /anamnesis_general_questions/{questionId} {
        allow read: if true;
        allow write: if daClinica(c);
      }

      match /anamnesis_templates/{templateId} {
        allow read: if true;
        allow write: if daClinica(c);
      }

      // Cadastros e fichas preenchidas: só a equipe. A paciente abre e salva a ficha pelo servidor
      // (`/api/ficha-publica`), que confere o link e não passa por estas regras.
      // No plano gratuito, até 5 clientes (criação contada; arquivada conta).
      match /patients/{patientId} {
        allow read, update, delete: if daClinica(c);
        allow create: if daClinica(c)
          && (!planoGratuito(c) || criacaoContada(c, 'clientes', 'ultimoCliente', patientId, 5));
      }

      match /anamnesis_records/{recordId} {
        allow read, write: if daClinica(c);
      }

      // Orçamentos: `get` público (o segredo é o id, um randomUUID), `list` e escrita só da equipe.
      match /quotes/{quoteId} {
        allow get: if true;
        allow list, write: if daClinica(c);
      }

      // Numeração sequencial de orçamentos e recibos.
      match /counters/{counterId} {
        allow read, write: if daClinica(c);
      }

      // Recibos levam o CPF da cliente e vão para ela em PDF, não por link: fechados.
      match /receipts/{receiptId} {
        allow read, write: if daClinica(c);
      }

      // Agenda e planos de sessão: só a equipe.
      match /attendances/{attendanceId} {
        allow read, write: if daClinica(c);
      }

      match /session_plans/{planId} {
        allow read, write: if daClinica(c);
      }

      // Link do agendamento (?agendamento=<token>): `get` público por id; quem não tem login só
      // atualiza os três campos da resposta, enquanto o agendamento está ativo, e com a resposta
      // validada. Mesma regra de `/firestore.rules`.
      match /appointment_links/{token} {
        function respostaValida(r) {
          return r is map
            && r.keys().hasOnly(['tipo', 'novaData', 'novaHora', 'mensagem'])
            && r.tipo in ['confirmar', 'nao_vai', 'remarcar']
            && (!('mensagem' in r) || (r.mensagem is string && r.mensagem.size() <= 300))
            && (r.tipo != 'remarcar' || (
                  'novaData' in r && r.novaData is string
                  && r.novaData.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                  && 'novaHora' in r && r.novaHora is string
                  && r.novaHora.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')))
            && (r.tipo == 'remarcar' || (!('novaData' in r) && !('novaHora' in r)));
        }

        allow get: if true;
        allow list, create, delete: if daClinica(c);
        allow update: if daClinica(c)
          || (
            resource.data.situacao == 'ativo'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['resposta', 'respostaPendente', 'respondidoEm'])
            && request.resource.data.respostaPendente == true
            && request.resource.data.respondidoEm is string
            && request.resource.data.respondidoEm.size() <= 40
            && respostaValida(request.resource.data.resposta)
          );
      }

      // Avaliação e acompanhamento (modelos, perguntas e registros): documento interno da equipe,
      // que a paciente nunca vê.
      match /evaluation_templates/{templateId} {
        allow read, write: if daClinica(c);
      }

      match /evaluation_general_questions/{questionId} {
        allow read, write: if daClinica(c);
      }

      match /evaluation_records/{recordId} {
        allow read, write: if daClinica(c);
      }

      match /followup_templates/{templateId} {
        allow read, write: if daClinica(c);
      }

      match /followup_general_questions/{questionId} {
        allow read, write: if daClinica(c);
      }

      match /followup_records/{attendanceId} {
        allow read, write: if daClinica(c);
      }

      // Estoque, consumo padrão, materiais por atendimento e custo dos orçamentos: custo e margem
      // são da equipe.
      match /stock_products/{productId} {
        allow read, write: if daClinica(c);
      }

      match /procedure_consumption/{procedureId} {
        allow read, write: if daClinica(c);
      }

      match /attendance_materials/{attendanceId} {
        allow read, write: if daClinica(c);
      }

      match /quote_costs/{quoteId} {
        allow read, write: if daClinica(c);
      }
    }

    // Qualquer outro caminho — inclusive uma coleção nova dentro da clínica que ainda não tenha
    // regra aqui — fica fechado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
